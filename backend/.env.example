# ----------------------------------------------------------------------
# Backend Environment Variables (Spring Boot)
# ----------------------------------------------------------------------

# The port the application runs on. Render will inject this automatically!
# For local development, it defaults to 8080.
PORT=8080

# The connection string to your database.
# In Render, click on your PostgreSQL database and copy the "Internal Database URL".
# Change "postgres://" at the start to "jdbc:postgresql://"
# Example: jdbc:postgresql://dpg-abcd123-a.oregon-postgres.render.com/projectflowdb
DB_URL=jdbc:postgresql://localhost:5432/project_management

# Your database username (In Render, copy the "User" value from your Database page)
DB_USERNAME=postgres

# Your database password (In Render, copy the "Password" value from your Database page)
DB_PASSWORD=postgres
